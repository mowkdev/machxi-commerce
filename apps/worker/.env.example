# Temporal worker — checkout workflows
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default

# Database — must match the API and root .env
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/machxi_commerce

# Object storage — invoices bucket (same S3 credentials as the API)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_INVOICES_BUCKET=machxi-invoices

# Stripe (optional; required only when stripe payment provider is enabled)
STRIPE_SECRET_KEY=
